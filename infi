//@version=5
indicator("SmartSignal Live 15m", overlay=true, max_lines_count=10, max_labels_count=50)

// ===== Inputs =====
emaFastLen = input.int(9,   "EMA Fast", minval=1)
emaSlowLen = input.int(21,  "EMA Slow", minval=1)
atrLen     = input.int(14,  "ATR Period", minval=1)
slMult     = input.float(1.5, "SL x ATR",  minval=0.5, step=0.1)
tp1Mult    = input.float(1.5, "TP1 x ATR", minval=0.5, step=0.1)
tp2Mult    = input.float(3.0, "TP2 x ATR", minval=0.5, step=0.1)
useVol     = input.bool(true,  "Volume Filter")
volMult    = input.float(1.2,  "Volume x MA", step=0.1)
useMACD    = input.bool(true,  "MACD Confirm")
useBB      = input.bool(true,  "Bollinger Confirm")
bbLen      = input.int(20,   "BB Period", minval=5)
bbMult2    = input.float(2.0, "BB StdDev", step=0.1)
rsiLen     = input.int(14,   "RSI Period", minval=1)
rsiOB      = input.int(55,   "RSI Min LONG")
rsiOS      = input.int(45,   "RSI Max SHORT")

// ===== Calculations =====
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
rsi      = ta.rsi(close, rsiLen)
atr      = ta.atr(atrLen)

[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdBull = macdLine > signalLine
macdBear = macdLine < signalLine

bbBasis  = ta.sma(close, bbLen)
bbDev    = bbMult2 * ta.stdev(close, bbLen)
aboveMid = close > bbBasis
belowMid = close < bbBasis

volMA = ta.sma(volume, 20)
volOk = not useVol or (volume > volMA * volMult)

// ===== TREND-BASED CONDITIONS (no crossover needed) =====
//      
trendLong  = emaFast > emaSlow
trendShort = emaFast < emaSlow

macdCL = not useMACD or macdBull
macdCS = not useMACD or macdBear
bbCL   = not useBB or aboveMid
bbCS   = not useBB or belowMid

//  :     
crossUp   = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

longCond  = crossUp   and rsi > rsiOB and macdCL and bbCL and volOk
shortCond = crossDown and rsi < rsiOS and macdCS and bbCS and volOk

// ===== LIVE STATUS -    =====
//            
liveStatusLong  = trendLong  and macdCL and bbCL and rsi > 50
liveStatusShort = trendShort and macdCS and bbCS and rsi < 50

// ===== State =====
var string lastSignal = "None"
var float  entryPrice = na
var float  tp1Price   = na
var float  tp2Price   = na
var float  slPrice    = na
var string sigTime    = ""
var bool   inTrade    = false
var bool   tp1Hit     = false
var bool   tp2Hit     = false
var bool   slHit      = false

if longCond
    lastSignal := "LONG"
    entryPrice := close
    slPrice    := close - slMult  * atr
    tp1Price   := close + tp1Mult * atr
    tp2Price   := close + tp2Mult * atr
    sigTime    := str.format("{0,time,yyyy-MM-dd HH:mm}", time)
    inTrade    := true
    tp1Hit     := false
    tp2Hit     := false
    slHit      := false

if shortCond
    lastSignal := "SHORT"
    entryPrice := close
    slPrice    := close + slMult  * atr
    tp1Price   := close - tp1Mult * atr
    tp2Price   := close - tp2Mult * atr
    sigTime    := str.format("{0,time,yyyy-MM-dd HH:mm}", time)
    inTrade    := true
    tp1Hit     := false
    tp2Hit     := false
    slHit      := false

// ===== TP/SL Hit Check =====
if inTrade and not slHit
    if lastSignal == "LONG"
        if not tp1Hit and high >= tp1Price
            tp1Hit := true
            label.new(bar_index, tp1Price, "TP1", style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
        if not tp2Hit and high >= tp2Price
            tp2Hit  := true
            inTrade := false
            label.new(bar_index, tp2Price, "TP2 Hit", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.normal)
        if low <= slPrice
            slHit   := true
            inTrade := false
            label.new(bar_index, slPrice, "SL Hit", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.normal)
    if lastSignal == "SHORT"
        if not tp1Hit and low <= tp1Price
            tp1Hit := true
            label.new(bar_index, tp1Price, "TP1", style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
        if not tp2Hit and low <= tp2Price
            tp2Hit  := true
            inTrade := false
            label.new(bar_index, tp2Price, "TP2 Hit", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.normal)
        if high >= slPrice
            slHit   := true
            inTrade := false
            label.new(bar_index, slPrice, "SL Hit", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.normal)

// ===== Chart Shapes =====
plotshape(longCond,  title="LONG",  style=shape.labelup,   color=color.new(color.teal,   0), text="LONG",  location=location.belowbar, size=size.small)
plotshape(shortCond, title="SHORT", style=shape.labeldown, color=color.new(color.maroon, 0), text="SHORT", location=location.abovebar, size=size.small)

plot(emaFast, title="EMA 9",  color=color.new(color.orange, 0), linewidth=1)
plot(emaSlow, title="EMA 21", color=color.new(color.purple, 0), linewidth=1)

// ===== Lines =====
var line lEntry = na
var line lSL    = na
var line lTP1   = na
var line lTP2   = na

if longCond or shortCond
    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    lEntry := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, extend=extend.right, color=color.new(color.blue,  0), style=line.style_dotted, width=2)
    lSL    := line.new(bar_index, slPrice,    bar_index + 1, slPrice,    extend=extend.right, color=color.new(color.red,   0), style=line.style_dashed, width=2)
    lTP1   := line.new(bar_index, tp1Price,   bar_index + 1, tp1Price,   extend=extend.right, color=color.new(color.lime,  0), style=line.style_dashed, width=1)
    lTP2   := line.new(bar_index, tp2Price,   bar_index + 1, tp2Price,   extend=extend.right, color=color.new(color.green, 0), style=line.style_solid,  width=2)

// ===== PANEL =====
var table panel = table.new(position.top_right, 2, 11, border_width=1, border_color=color.new(color.gray, 40))

//  :          
liveSignal = inTrade ? lastSignal : liveStatusLong ? "WATCH LONG" : liveStatusShort ? "WATCH SHORT" : "NO SIGNAL"

panelBg =
     slHit          ? color.new(color.red,    30) :
     tp2Hit         ? color.new(color.green,  20) :
     tp1Hit         ? color.new(color.lime,   40) :
     inTrade        ? color.new(color.blue,   50) :
     liveStatusLong  ? color.new(color.teal,  70) :
     liveStatusShort ? color.new(color.orange,70) :
                       color.new(color.gray,  70)

headerColor =
     inTrade and lastSignal == "LONG"  ? color.new(color.teal,   0) :
     inTrade and lastSignal == "SHORT" ? color.new(color.maroon, 0) :
     liveStatusLong                    ? color.new(color.teal,   40):
     liveStatusShort                   ? color.new(color.maroon, 40):
                                         color.new(color.gray,   30)

if barstate.islast
    table.cell(panel, 0, 0, "SmartSignal Live", text_color=color.white, bgcolor=headerColor, text_size=size.small)
    table.cell(panel, 1, 0, "15m | All Pairs",  text_color=color.white, bgcolor=headerColor, text_size=size.small)

    table.cell(panel, 0, 1, "Market Now", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 1, liveSignal,   text_color=color.white,  bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 2, "Entry", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 2, na(entryPrice) ? "---" : str.tostring(entryPrice, format.mintick), text_color=color.aqua, bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 3, "Stop Loss", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 3, na(slPrice) ? "---" : str.tostring(slPrice, format.mintick), text_color=color.red, bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 4, "TP1", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 4, na(tp1Price) ? "---" : str.tostring(tp1Price, format.mintick), text_color=color.lime, bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 5, "TP2", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 5, na(tp2Price) ? "---" : str.tostring(tp2Price, format.mintick), text_color=color.green, bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 6, "Signal Time", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 6, sigTime == "" ? "---" : sigTime, text_color=color.yellow, bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 7, "Status", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 7,
         slHit   ? "SL Hit - Closed" :
         tp2Hit  ? "TP2 Hit - Closed" :
         tp1Hit  ? "TP1 Hit - Hold" :
         inTrade ? "Active Trade" :
         liveStatusLong  ? "Setup Forming LONG" :
         liveStatusShort ? "Setup Forming SHORT" :
         "Waiting for Signal",
         text_color=color.white, bgcolor=panelBg, text_size=size.small)

    // RSI  MACD 
    table.cell(panel, 0, 8, "RSI Now", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 8, str.tostring(rsi, "#.##"), text_color=rsi > 50 ? color.lime : color.red, bgcolor=panelBg, text_size=size.small)

    table.cell(panel, 0, 9, "MACD Trend", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 9, macdBull ? "Bullish" : "Bearish", text_color=macdBull ? color.lime : color.red, bgcolor=panelBg, text_size=size.small)

    rrRatio = na(entryPrice) or na(slPrice) or na(tp2Price) ? na : math.abs(tp2Price - entryPrice) / math.abs(entryPrice - slPrice)
    table.cell(panel, 0, 10, "R:R", text_color=color.silver, bgcolor=panelBg, text_size=size.small)
    table.cell(panel, 1, 10, na(rrRatio) ? "---" : "1 : " + str.tostring(rrRatio, "#.##"), text_color=color.orange, bgcolor=panelBg, text_size=size.small)

// ===== Alerts =====
alertcondition(longCond,  title="LONG Signal",  message="LONG | Entry: {{close}} | 15m")
alertcondition(shortCond, title="SHORT Signal", message="SHORT | Entry: {{close}} | 15m")
alertcondition(longCond or shortCond, title="Any Signal", message="New Signal - 15m")
